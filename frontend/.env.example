# Локально: Vite проксирует /api → backend (см. vite.config.ts)
VITE_API_BASE_URL=/api

# Продакшен (Railway): полный URL бэкенда без слэша в конце — задать в Build Variables фронтенда.
# Если не задано, в production-сборке используется запасной URL из shared/api/config.ts
# VITE_API_BASE_URL=https://investments-production-000e.up.railway.app
