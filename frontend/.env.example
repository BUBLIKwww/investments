# Локально: Vite проксирует /api → backend (см. vite.config.ts)
VITE_API_BASE_URL=/api

# Продакшен (Railway): полный URL бэкенда БЕЗ слэша в конце.
# НЕ используйте здесь /api — на статическом фронте прокси нет, запросы уйдут не туда.
# Если переменная не задана или относительная, в production подставится URL из shared/api/config.ts
# VITE_API_BASE_URL=https://investments-production-000e.up.railway.app
