APP_NAME=Investment Assistant API
DEBUG=false
DATABASE_URL=sqlite:///./data/dev.db

# T-Invest (Invest API): токен https://www.tbank.ru/invest/settings/api/ (по умолчанию production, не sandbox).
TINVEST_TOKEN=
TINVEST_USE_SANDBOX=false
# Если счёт не сохранён в БД (broker_settings), можно подставить account_id из списка счетов API.
TINVEST_DEFAULT_ACCOUNT_ID=
# PostgreSQL (Railway и т.п.), драйвер в requirements.txt:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# CORS: пока true — разрешены все origin (для Railway). Потом false + список ниже.
# CORS_ALLOW_ALL=true
# CORS_ORIGINS=["https://your-frontend.up.railway.app","https://web.telegram.org"]
